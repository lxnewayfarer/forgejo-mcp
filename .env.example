# ── Server ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public URL the server is reachable at (used for redirect display & MCP URL).
PUBLIC_BASE_URL=http://localhost:3000

# ── Datastores ─────────────────────────────────────────────────────────
# For docker compose, host is the service name "postgres".
DATABASE_URL=postgresql://forgejo_mcp:forgejo_mcp@localhost:5432/forgejo_mcp?schema=public

# Postgres credentials consumed by docker-compose.yml. POSTGRES_PASSWORD is
# REQUIRED (compose has no default) — pick a strong value. In NODE_ENV=production
# the app refuses to start with a well-known weak password or a localhost DB.
POSTGRES_USER=forgejo_mcp
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=forgejo_mcp

# ── Forgejo OAuth application ───────────────────────────────────────────
# Origin of your Forgejo instance (no trailing /api/v1).
FORGEJO_BASE_URL=https://forgejo.example.com
FORGEJO_CLIENT_ID=your_oauth_application_id
FORGEJO_CLIENT_SECRET=your_oauth_application_secret
# Must EXACTLY match the redirect URI registered on the Forgejo OAuth app.
FORGEJO_REDIRECT_URI=http://localhost:3000/auth/callback
# Scopes: read:user (login) + write:repository / write:issue (PRs, reviews,
# comments, labels, Actions logs). Only enforced when the instance sets
# [oauth2] ENABLE_ADDITIONAL_GRANT_SCOPES = true; otherwise tokens get full access.
FORGEJO_SCOPES=read:user write:repository write:issue

# ── Crypto ─────────────────────────────────────────────────────────────
# 32-byte key for AES-256-GCM token encryption.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace_me_with_64_hex_chars_from_openssl_rand_hex_32

# ── Sessions / tokens ──────────────────────────────────────────────────
SESSION_TTL_HOURS=168
TOKEN_REFRESH_SKEW_SECONDS=60

# OAuth (MCP client-driven). Code TTL is short; refresh TTL longer.
OAUTH_CODE_TTL_SECONDS=60
OAUTH_REFRESH_TTL_HOURS=720
